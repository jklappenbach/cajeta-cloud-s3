package dev.cajeta.cloud.s3;

import cajeta.collection.ArrayList;
import cajeta.lang.String;

/**
 * What one S3-compatible service lacks or rules differently (cloudflare spec
 * 2.4): the capabilities it does not offer, each with a caveat, and its
 * multipart part rule. A store built with a profile declares only the
 * capabilities the profile keeps, and an excluded operation refuses per the
 * parent's §3.2 before any request is made. The profile's name is the
 * adapter's name in capabilities and errors. A service's own error codes, or
 * S3 codes it means differently, are `errorKind` entries that the store
 * consults before S3's table. `aws()` excludes nothing: every part but the
 * last is at least 5 MiB, in any sizes.
 */
public final class S3Profile {
    String adapter;
    ArrayList<String> excluded;
    ArrayList<String> caveats;
    int64 minPart;
    boolean uniform;
    ArrayList<String> codes;
    ArrayList<int32> kinds;

    public S3Profile(String name) {
        this.adapter = "" + name;
        this.excluded = heap ArrayList<String>();
        this.caveats = heap ArrayList<String>();
        this.minPart = 5242880L;
        this.uniform = false;
        this.codes = heap ArrayList<String>();
        this.kinds = heap ArrayList<int32>();
        return;
    }

    /** An owned copy, for a store that outlives the profile it was built from. */
    public #S3Profile copy() {
        S3Profile c = heap S3Profile(this.adapter);
        for (int32 i = 0; i < this.excluded.count(); i++) {
            c.exclude(this.excluded.get(i), this.caveats.get(i));
        }
        for (int32 i = 0; i < this.codes.count(); i++) {
            c.errorKind(this.codes.get(i), this.kinds.get(i));
        }
        c.partRule(this.minPart, this.uniform);
        return #c;
    }

    /** AWS S3: the reference, with nothing excluded. */
    public static #S3Profile aws() {
        return heap S3Profile("s3");
    }

    /** The service does not offer `capability` (a `Caps` name); `caveat` says why. */
    public void exclude(String capability, String caveat) {
        String c = "" + capability;
        String v = "" + caveat;
        this.excluded.add(#c);
        this.caveats.add(#v);
        return;
    }

    /** The smallest part but the last, and whether every part but the last must be the same size. */
    public void partRule(int64 minPartSize, boolean uniformParts) {
        this.minPart = minPartSize;
        this.uniform = uniformParts;
        return;
    }

    /**
     * The service answers `code` (an `<Error><Code>`) meaning `kind` (a
     * CloudException kind), where S3's table says otherwise or has no entry.
     */
    public void errorKind(String code, int32 kind) {
        String c = "" + code;
        this.codes.add(#c);
        this.kinds.add(kind);
        return;
    }

    /** The kind this profile gives `code`, or -1 to fall back to S3's table. */
    public int32 kindFor(String code) {
        for (int32 i = 0; i < this.codes.count(); i++) {
            if (this.codes.get(i).equals(code)) return this.kinds.get(i);
        }
        return -1;
    }

    public boolean excludes(String capability) {
        for (int32 i = 0; i < this.excluded.count(); i++) {
            if (this.excluded.get(i).equals(capability)) return true;
        }
        return false;
    }

    /** The caveat given when `capability` was excluded, or "". */
    public #String caveatFor(String capability) {
        for (int32 i = 0; i < this.excluded.count(); i++) {
            if (this.excluded.get(i).equals(capability)) return "" + this.caveats.get(i);
        }
        return "" + "";
    }

    public String name() { return this.adapter; }
    public int64 minPartSize() { return this.minPart; }
    public boolean uniformParts() { return this.uniform; }
}
